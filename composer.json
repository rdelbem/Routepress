{
    "name": "rdelbem/routepress",
    "description": "A WordPress lib to create APIs easily",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "wordpress",
        "rest",
        "api",
        "router",
        "jwt"
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "phpunit/phpunit": "^11.5",
        "php-stubs/wordpress-stubs": "^6.6",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^4.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Routepress\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Routepress\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/tests/bootstrap.php"
        ]
    },
    "authors": [
        {
            "name": "rdelbem",
            "email": "rodrigodelbem@gmail.com"
        }
    ],
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse",
        "lint": "vendor/bin/phpcs",
        "format": "vendor/bin/phpcbf",
        "hooks": "@php bin/install-hooks.php"
    },
    "post-install-cmd": [
        "@hooks"
    ],
    "post-update-cmd": [
        "@hooks"
    ],
    "config": {
        "sort-packages": true
    }
}
