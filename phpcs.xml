<?xml version="1.0"?>
<ruleset name="Routepress">
    <description>Routepress coding standard (PSR-12).</description>

    <file>src</file>
    <file>tests</file>
    <file>bin</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tests/bootstrap.php</exclude-pattern>
    <exclude-pattern>*/tests/Cli/fixtures/*</exclude-pattern>

    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="basepath" value="."/>

    <rule ref="PSR12"/>
</ruleset>
